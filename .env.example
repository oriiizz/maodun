# 复制为 .env 后再填写。这个文件里不要放真实密钥。
# 程序只读取项目根目录的 .env；本示例文件不会被读取。

DATABASE_PATH=data/maodun.db
ORIGINALS_DIR=data/originals
REQUEST_TIMEOUT_SECONDS=30

# 文字问答：本地知识库 + DeepSeek 官方接口。有效密钥只填下一行，不要写进 web/。
# 模型名按当前官方文档：deepseek-flash。思考模式关闭，回答直接作为口播正文。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 百度实时语音识别：把 ASR_PROVIDER 改成 baidu_realtime，并只在 .env 填写真实 API Key。
# 浏览器向本项目发送 16kHz、单声道、16bit PCM；密钥只由后端发给百度。
ASR_PROVIDER=none
BAIDU_ASR_APP_ID=你的百度应用数字编号
BAIDU_ASR_API_KEY=
BAIDU_ASR_WS_URL=wss://vop.baidu.com/realtime_asr

# 旧的整段音频 HTTP 识别替换位，不使用时保持为空。
ASR_BASE_URL=

# 阿里云百炼 CosyVoice 非实时语音合成。真实 Key 只填项目根目录的 .env。
# 北京地域示例 Host 中的 {workspace_id} 会由 DASHSCOPE_WORKSPACE_ID 替换。
# 若控制台提供了其他地域的专属 API Host，请原样替换 DASHSCOPE_API_HOST。
TTS_PROVIDER=dashscope_cosyvoice
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_API_HOST=https://{workspace_id}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang
DASHSCOPE_TTS_FORMAT=wav
DASHSCOPE_TTS_SAMPLE_RATE=24000
DASHSCOPE_TTS_TIMEOUT_SECONDS=60

# system 使用上面的系统音色；clone 使用复刻音色。
# 复刻音色 ID 可与 data/voices/maodun.json 里的 voice_id 一致，必须和 DASHSCOPE_CLONE_MODEL 配套。
DASHSCOPE_TTS_VOICE_SOURCE=clone
DASHSCOPE_CLONE_MODEL=cosyvoice-v3-flash
DASHSCOPE_CLONE_VOICE_ID=

# 其他自建 HTTP TTS 可改为 TTS_PROVIDER=http，并填写完整服务地址。
TTS_BASE_URL=
AVATAR_PROVIDER=none
